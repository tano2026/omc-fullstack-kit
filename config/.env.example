# ==============================================================================
# OMC FULLSTACK MASTER KIT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env và điền các khóa API của bạn trước khi vận hành.
# ==============================================================================

# Thông tin định danh công ty
COMPANY_NAME="Tano Digital Agency"
COMPANY_DOMAIN="AI Automation & Full-Stack Development"

# Cổng Telegram Bot (Lấy từ @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Khóa API OpenRouter (Ưu tiên số 1 - Hỗ trợ $0 Free Tier)
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# Model mặc định cho tầng phản xạ Ingress Gateway
DEFAULT_MODEL="openrouter/free"

# Khóa DeepSeek Direct API (Tùy chọn - Dùng cho Fallback Chain)
DEEPSEEK_API_KEY=""

# Khóa Google AI Studio API (Tùy chọn - Gemini Flash)
GOOGLE_API_KEY=""

# Khóa HHTech / OmniRoute Proxy (Tùy chọn)
HHTECH_API_KEY=""
